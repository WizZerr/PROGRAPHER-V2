# איפה ProGrapher ישמור את כל הדאטה המקומי.
# אפשר לשנות לכונן אחר, לדוגמה:
# PROGRAPHER_DATA_DIR=D:\ProGrapherData
PROGRAPHER_DATA_DIR=./data

# הכתובות שמורשות לדבר עם ה-Backend.
# השארנו גם localhost וגם את הדומיין שלך.
PROGRAPHER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prographer.proride.co.il

# אם בהמשך נחבר Tunnel קבוע אפשר להגדיר כאן כתובת ציבורית.
# לדוגמה: https://engine.prographer.proride.co.il
PROGRAPHER_PUBLIC_BASE_URL=

# כרגע כבוי כדי שנוכל לבדוק מקומית בלי להסתבך.
# לפני חשיפה קבועה לאינטרנט נפעיל אימות מסודר.
PROGRAPHER_REQUIRE_TOKEN=false

# טוקן אופציונלי לבדיקות פרטיות.
# אם PROGRAPHER_REQUIRE_TOKEN=true, יש לשלוח אותו בכותרת X-ProGrapher-Token
PROGRAPHER_TOKEN=change-me
